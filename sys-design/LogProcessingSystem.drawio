        <mxCell id="NR5q41wo-2A-5KUITIE7-2" parent="1" style="whiteSpace=wrap;html=1;align=left;rounded=0;" value="Design&lt;br&gt;Injest POST /v1/event/ {Payload}&lt;br&gt;search GET /v1/search?q={query}&lt;br&gt;&lt;br&gt;To Support 2500 TPS, use message queue/&lt;div&gt;Can&#39;t process Sync&lt;br&gt;Use Elasticsearch&lt;/div&gt;&lt;div&gt;Archive in cold storage&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
