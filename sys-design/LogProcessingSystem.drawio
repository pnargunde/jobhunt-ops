        <mxCell id="NR5q41wo-2A-5KUITIE7-6" parent="1" style="whiteSpace=wrap;html=1;align=left;rounded=0;" value="Components&lt;br&gt;&lt;br&gt;&lt;div&gt;Agents=log collection(config heavy), parse, filtering, compressing(save network), buffer and throttle (during high load), add Metadata&lt;br&gt;&lt;br&gt;- file based,&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;syslog&lt;/span&gt;&lt;/div&gt;&lt;div&gt;- network based&lt;/div&gt;&lt;div&gt;&lt;br&gt;Log Server&lt;/div&gt;&lt;div&gt;- Receiver&lt;/div&gt;&lt;div&gt;- Processor&lt;br&gt;&lt;br&gt;Queue Options&lt;/div&gt;&lt;div&gt;Native Internal queue&lt;/div&gt;&lt;div&gt;Scalability (kafka)&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
