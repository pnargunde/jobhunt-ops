        <mxCell id="NR5q41wo-2A-5KUITIE7-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="Functional/ User Requirement&lt;div&gt;Gather logs from large numbers of diverse sources&lt;br&gt;Process, Filter and Store for atleast 30 days&lt;br&gt;Provide Search&lt;/div&gt;&lt;div&gt;Archive old logs&lt;/div&gt;&lt;div&gt;Other downstream(Analytics, Monitoring, Alerting, dashboards, regulatory)&lt;/div&gt;&lt;div&gt;Debuggin*&lt;/div&gt;&lt;div&gt;Descope = Metrics and Distributed Traces&lt;br&gt;&lt;br&gt;Estimate&lt;/div&gt;&lt;div&gt;500 sources&lt;br&gt;5 log/s&amp;nbsp;&lt;br&gt;1 KB/message&lt;/div&gt;&lt;div&gt;TPS = 2500&lt;/div&gt;&lt;div&gt;Storage = 500 * 5 * 10e4 = 25GB&lt;br&gt;25GB x 30 = 750GB per month&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="250" x="30" y="30" as="geometry" />
        </mxCell>
        <mxCell id="NR5q41wo-2A-5KUITIE7-7" edge="1" parent="1" source="NR5q41wo-2A-5KUITIE7-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="NR5q41wo-2A-5KUITIE7-6" value="">
