        <mxCell id="X76g_Gz4g_v35CMTco31-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;BR&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Semd amd receive messages&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Group and One to One&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Media yes&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Use Cases&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;1. Send 1 to 1 message&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;2. Send group message&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;3. Receive messages in order(?)&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;4. Presence server&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;5. Group Size 100&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Out of scope&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;1. Encryption&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;2. User Signup and management&lt;br&gt;&lt;br&gt;ESTIMATES&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;1 Billion DAU, 20 message/day&lt;br&gt;message size 1KB&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;TPS = 20 10e9 / 10e5 = 20 10e4&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;= 200,000 TPS huge&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;Storage = 20 10e9 x 1e3&amp;nbsp; = 7 PB /year&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="230" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="X76g_Gz4g_v35CMTco31-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Architecture Choice&lt;div&gt;HTTP microservices for Onboarding, User management, Auth, Media uploads etc&lt;/div&gt;&lt;div&gt;Websockets Autoscaling chat servers&lt;/div&gt;&lt;div&gt;Group service - Group membership, size etc&lt;/div&gt;&lt;div&gt;User Service - User metadata&lt;/div&gt;&lt;div&gt;Message queue - not architectural queue but user specific queue&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;DB Choices&lt;/div&gt;&lt;div&gt;User and Groups = RDBMS&lt;/div&gt;&lt;div&gt;Messages = Key Value Store(like kafka) &amp;amp; archive storage&lt;br&gt;Presence information ?&lt;/div&gt;" vertex="1">
