      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="oD6ItzfqS0iUwNnPW25h-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Requirements&lt;/div&gt;&lt;div&gt;&lt;br&gt;1:1 and group messages&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Support phone and computer(multiple session/user)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;Message type: docs, media and text&lt;/div&gt;&lt;div&gt;Message size: 10KB&lt;/div&gt;&lt;div&gt;Notifications&lt;/div&gt;&lt;div&gt;Global&lt;/div&gt;&lt;div&gt;E2E Encryption&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Estimations&lt;/div&gt;&lt;div&gt;1billion&amp;nbsp;&lt;/div&gt;&lt;div&gt;100million DAU&lt;/div&gt;&lt;div&gt;20 message per person&lt;/div&gt;&lt;div&gt;TPS = 10e8 x 20 / 10e4 = 20 10e4 = 20,000/s&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="230" width="280" x="10" y="40" as="geometry" />
        </mxCell>
        <mxCell id="oD6ItzfqS0iUwNnPW25h-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Services and Protocols&lt;div&gt;Stateful and Websocket backed&lt;br&gt;&lt;div&gt;Location/Presence service&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Message/Chat Broker Service&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;br&gt;&lt;div&gt;Stateless and traditional HTTP&lt;/div&gt;&lt;div&gt;Group Service&lt;/div&gt;&lt;div&gt;User Service&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;Auth Service&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="180" x="320" y="70" as="geometry" />
        </mxCell>
        <mxCell id="oD6ItzfqS0iUwNnPW25h-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Message Delivery&lt;div&gt;Fan out for small groups&lt;br&gt;Pull Based for large groups&lt;/div&gt;&lt;div&gt;Send message if online, notify if offline&lt;/div&gt;&lt;div&gt;1 active delivery queue per&amp;nbsp;&lt;/div&gt;&lt;div&gt;user to user&lt;br&gt;user to (group .. group) to user&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
