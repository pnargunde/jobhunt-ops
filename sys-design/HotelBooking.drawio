        <mxCell id="jeDy7UZnUh1UGIpTU1VL-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;div&gt;Functional&amp;nbsp;&lt;br&gt;Hosts creates property&lt;br&gt;Customers book and manage it&lt;br&gt;&lt;br&gt;&lt;/div&gt;Users&lt;br&gt;Property Admins -&amp;gt; &lt;br&gt;Create, Manage, Delete Property&lt;br&gt;Guests -&amp;gt; &lt;br&gt;Search, Book and Manage, Payment (review, message etc)&lt;br&gt;&lt;br&gt;Out of scope&lt;br&gt;User management&lt;br&gt;&lt;br&gt;&lt;br&gt;API&amp;nbsp;&lt;div&gt;/v1/property/&lt;br&gt;/v1/search/&lt;br&gt;/v1/booking/&lt;br&gt;/v1/payment/&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
